{
  "manifest_version": 3,
  "name": "Watch Later Downloader",
  "version": "1.0",
  "description": "Send current URL to yt-dlp",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "data_collection_permissions": {
    "required": ["none"],
    "collects_personal_data": false,
    "collects_usage_data": false,
    "collects_advertising_data": false
  },
  "permissions": ["nativeMessaging", "activeTab"],
  "action": {
    "default_title": "Download Video",
    "default_icon": {
      "48": "icon-48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "watch_later_ext@k11m1.eu"
      ,
      "data_collection_permissions": {
        "required": ["none"],
        "collects_personal_data": false,
        "collects_usage_data": false,
        "collects_advertising_data": false
      }
    }
  }
}

